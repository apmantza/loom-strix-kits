# Machine settings for common/*.sh: copy to ~/.config/loom-strix-kits/env (or point LSK_ENV at a copy) and edit.
# VENV=/opt/loom/.venv                 # a venv with hrx-loom 0.2.0 (loom-serve, loom-compile, loom-test)
# VENV_NEXT=/opt/loom/.venv-next       # optional: the next hrx-loom (a port in preparation); common/fresh.py diffs its tool surface against VENV's
# HRX_SYSTEM=/opt/hrx-system           # optional: an hrx-system git checkout with release tags; fresh.py lists docs/workflows per tag
# LOOM_SURFACE_CACHE=~/.cache/loom-strix-kits/loom-surface   # optional: where fresh.py keeps a tool-surface snapshot per Loom version
# PYTHON=python3                       # with gguf, numpy, tokenizers, requests
# LOOM_SKILLS=/opt/loom-skills         # a loom-fun/loom-skills checkout (knowledge base, gates, bench helpers)
# LOOM_KB_ROOT=/opt/loom-skills/skills/loom-kb
# LLAMACPP_DIR=/opt/llama.cpp/build/bin   # llama-server for the gates' reference outputs
# WORK=/data/qwen                      # where packages, models/ and tok/ live (default: the kit directory)
# PORT=8160
# A server another tool manages on PORT (a launcher, a systemd unit): how to stop it for a measurement and bring it back.
# LSK_STOP_HOOK='systemctl --user stop my-llm'
# LSK_RESTORE_HOOK='systemctl --user start my-llm'
# IREE_PROFILE=/opt/hrx-system/build/runtime/src/iree/tools/iree-profile/iree-profile   # for common/events_ab.sh
# ROCM_SDK=/opt/rocm                    # a ROCm root with hipcc and gfx device libraries (common/bw_probe.sh)
# HRX_SYSTEM=/opt/hrx-system             # an ROCm/hrx-system checkout with its release tags: the commit-msg check verifies Loom-builtin trailer citations at a tag
