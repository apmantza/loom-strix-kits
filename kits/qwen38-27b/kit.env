# Qwen3.8-27B kit manifest (read by common/*.sh). Paths are relative to WORK (default: this directory; fetch.sh fills it).
KIT_MODEL_ID=Qwen/Qwen3.8-27B
KIT_CONFIG=${KIT_CONFIG:-config.json}   # relative to this directory, or absolute
KIT_TOKENIZER=tok/tokenizer.json
KIT_REF_GGUF=models/Qwen3.8-27B-UD-Q4_K_XL.gguf
# the current recipe: generator switches (kit/*.py read them; unset = unchanged program)
KIT_RECIPE="PREFILL_F16_SCRATCH=1 ATTN_L17_VS=1 FLASH2_PF11=1 FLASH2_KVH11=1 KV8=1 GDN_FOLD=1 FLASH2_VS_KVH=1 FLASH2_SPLITK_ANY=1 DFL_SPLIT_W=1 PF16_PAD=64 GDN_AB_R=1 DRAFT_MM_FROM=17 F16O11=1 EPI_FUSE=1 FLASH2_HEADPACK=1 GEMM256_FLATADDR=1 F16O_O=1 FLASH2_SX11=1 FLASH2_SXH=1 FLASH2_SMX=1"
KIT_BUILD_ARGS=${KIT_BUILD_ARGS:-"--model-id Qwen/Qwen3.8-27B --pool 524544 --rows 4 --prefill 4096 --temperature 1.0 --top-p 0.95 --top-k 20"}
# fixed pool backing: KV8 is only correct with it on Loom 0.2.0, and elastic costs prefill on Strix Halo
KIT_SERVE_ARGS="--device=amdgpu://?completion_spin_ns=4294967295 --pool_backing=fixed --workers=8"
# lanes and hardware floors for common/events_summary.py, ceiling.py, lane_breakdown.py
KIT_LANES=lanes.json
# a long-context profile request (common/profile_req.py): prompt tokens; the draft and decode behaviour comes from the package
KIT_PROFILE_TOKENS=81000
KIT_LANES_ARGS="--kv kv8 --gdn-state-mib 149.6"   # common/kit_check.sh: the flags make_lanes needs for this model
